# Install as /etc/warren-relay/relay.env, readable only by the service user.
WARREN_GATEWAY_URL=wss://leveret.unlessrabbit.my.id/api/ws
WARREN_GATEWAY_PUBLIC_URL=wss://leveret.unlessrabbit.my.id/api/ws
WARREN_GATEWAY_TOKEN=replace-with-existing-gateway-token
# Generate a separate token for this relay, then enter it in Warren settings.
WARREN_RELAY_TOKEN=replace-with-a-new-random-token-at-least-32-characters
WARREN_RELAY_DB=/var/lib/warren-relay/jobs.sqlite3
WARREN_RELAY_PORT=8766
GOOGLE_APPLICATION_CREDENTIALS=/etc/warren-relay/FIREBASE_SERVICE_ACCOUNT_KEY.json
